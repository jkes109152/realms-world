# 正式秘密請透過 Sites 秘密管理設定，不將此檔當成正式設定。
# 本機設定放在已忽略的 .dev.vars；秘密值自行設定。
SITE_ORIGIN=http://127.0.0.1:5173
DOWNLOADS_ENABLED=false
# G0 取得實際證據前維持空白，相關能力會拒絕執行。
REALMS_CLIENT_VERSION=
REALMS_DOWNLOAD_HOSTS=[]
REALMS_DOWNLOAD_REDIRECT_POLICY=[]
AUTH_ACTIVE_KEY_ID=
AUTH_KEYRING=
RATE_LIMIT_HMAC_KEY=
MAINTENANCE_TOKEN=
